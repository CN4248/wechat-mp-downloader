# 宿主机下载目录（相对路径或绝对路径均可），容器内统一挂载为 /download
DOWNLOAD_DIR=./downloads
# 可选：第二个下载目录（如fanbook），容器内固定挂载为 /fanbook
FANBOOK_DIR=./fanbook
# WebUI 端口
WEB_PORT=2178
# 时区
TZ=Asia/Shanghai
# 基础镜像（可按需换成官方镜像）
ALPINE_IMAGE=docker.m.daocloud.io/library/alpine:3.20
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
# 源码构建时的 Go 镜像与代理（仅 Dockerfile.source 使用）
GO_IMAGE=docker.m.daocloud.io/library/golang:1.22-alpine
GOPROXY=https://goproxy.cn,direct
# 可选：按篇追更所需的微信 Cookie（只放在本地环境变量里，不要提交到仓库）
# WXMP_COOKIE=
# 任务/追更数据目录
WXMP_DATA_DIR=./data
